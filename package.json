{
  "name": "veildrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run assets && next dev --webpack",
    "build": "npm run assets && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/copy-assets.mjs",
    "compile": "cd contract && compact compile src/main.compact managed/veildrop",
    "contract:build": "cd contract && npm run build",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "test": "npm run env:up && npm run test:contract",
    "test:contract": "vitest run --config vitest.config.ts",
    "test:app": "vitest run --config vitest.config.app.ts",
    "deploy:preprod": "npm run contract:build && node scripts/deploy-preprod.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "buffer": "^6.0.3",
    "effect": "^3.14.0",
    "fp-ts": "^2.16.11",
    "graphql": "^16.11.0",
    "next": "16.3.1",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "axios": "^1.13.6",
    "pino-pretty": "^13.0.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^11.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "ws": "^8.14.2"
  },
  "overrides": {
    "smoldot": "npm:@aspect-build/empty@0.0.0"
  }
}
