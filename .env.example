# VeilDrop environment configuration
#
# All variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle.
# NEVER place private keys, seed phrases, wallet secrets or reporter
# credentials in these (or any) environment variables.

# Midnight network to connect to (preprod | undeployed)
NEXT_PUBLIC_VEILDROP_NETWORK_ID=preprod

# Public Midnight Preprod indexer endpoints
NEXT_PUBLIC_VEILDROP_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
NEXT_PUBLIC_VEILDROP_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Address of the deployed VeilDrop Compact contract on Preprod
# (64 lowercase hex characters, no 0x prefix). Leave empty to let the app
# deploy a fresh contract from the connected Lace wallet.
NEXT_PUBLIC_VEILDROP_CONTRACT_ADDRESS=

# The commitment of the demo reporter credential used by the deployed
# contract (64 hex characters, no 0x prefix). Computed as
# credentialCommitment(DEMO_CREDENTIAL_SECRET). Leave empty to let the app
# derive it from the bundled demo credential.
# For the bundled demo credential this value is:
#   c1bad80f013287fbf7c5446730e305c5cee7882215cb0cfd0f0438e7dd8c3de7
NEXT_PUBLIC_VEILDROP_AUTHORIZED_CREDENTIAL_HASH=

# Optional: contract explorer base URL for transaction links.
NEXT_PUBLIC_VEILDROP_EXPLORER_URL=https://explorer.1am.xyz/?network=preprod

# ---------------------------------------------------------------------------
# Server-side only (used by scripts/deploy-preprod.mjs). NEVER commit these.
# ---------------------------------------------------------------------------

# Preprod wallet seed used to deploy the contract: a 64-char hex master seed
# or a space-separated mnemonic. The wallet must hold Preprod test tokens.
# VEILDROP_SEED=

# Override the proof server used during deployment (default: localhost:6300).
# VEILDROP_PROOF_SERVER=http://127.0.0.1:6300

# Override the authorized credential hash (default: demo credential commitment).
# VEILDROP_AUTHORIZED_CREDENTIAL_HASH=c1bad80f013287fbf7c5446730e305c5cee7882215cb0cfd0f0438e7dd8c3de7
